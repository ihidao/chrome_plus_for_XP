{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CHROME_PLUS_ARCH": "x86",
        "CHROME_PLUS_TARGET_XP": "ON",
        "CHROME_PLUS_USE_VC_LTL": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;MinSizeRel"
      }
    },
    {
      "name": "ninja",
      "displayName": "Ninja Multi-Config for Windows XP x86",
      "inherits": "base",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/ninja-x86-xp",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl.cmake"
    },
    {
      "name": "vs",
      "displayName": "Visual Studio for Windows XP x86",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/vs-x86-xp",
      "architecture": "Win32"
    }
  ]
}
